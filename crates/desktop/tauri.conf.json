{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SkyHub",
  "identifier": "dev.skyhub.app",
  "version": "0.1.0",

  "build": {
    "frontendDist": "../../apps/web/build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd ../../apps/web && pnpm dev",
    "beforeBuildCommand": "cd ../../apps/web && pnpm build"
  },

  "app": {
    "windows": [
      {
        "title": "SkyHub",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      },
      "wix": null
    },
    "publisher": "SkyCollective",
    "copyright": "Copyright 2024-2025 the SkyCollective. Licensed under AGPL-3.0-or-later."
  }
}
