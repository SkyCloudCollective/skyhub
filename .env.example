# RanchSamples — example environment. Copy to a runtime env (never commit a real
# .env). All values here are placeholders / off-by-default.

# ── catalog + storage ─────────────────────────────────────────────────────────
# RANCHSAMPLES_DB=./data/catalog.db
# RANCHSAMPLES_ROOT=./samples/synthetic
# RANCHSAMPLES_WEB=./apps/web/build      # built SPA dir; set to serve the app single-origin

# ── identity / auth (dormant until a homeserver is set) ───────────────────────
# RANCHSAMPLES_MATRIX_HS=https://matrix.example.org
# RS_ADMIN_HANDLES=alice,bob

# ── feature gate: public UGC (off until the legal pass) ───────────────────────
# RS_OPEN_UGC=0

# ── hub: external self-hosted services (the /media page) ──────────────────────
# Point each at YOUR own instance; unset services are hidden. No default = no host
# in the repo. Examples only:
# RS_HUB_JELLYFIN_URL=https://jellyfin.example.org
# RS_HUB_NAVIDROME_URL=https://music.example.org
# RS_HUB_SEERR_URL=https://requests.example.org

# ── gated preview: HTTP Basic front-door lock (RUNTIME ONLY) ──────────────────
# When set to "user:password", every route is protected except /healthz.
# Unset = no gate. This is a PLACEHOLDER — set a real value only at runtime.
# RS_BASIC_AUTH=preview:change-me
